<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.org for everything, plus the git-ignored local feed for Jiron Form Builder's own test packs.
    Package source mapping makes sure Jiron Form Builder's ids can only ever come from the local feed,
    and everything else only from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="jfb-local" value=".local/nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="jfb-local">
      <package pattern="Jiron.Umbraco.FormBuilder" />
      <package pattern="Jiron.Umbraco.FormBuilder.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
