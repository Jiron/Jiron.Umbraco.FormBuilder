<Project>

  <!--
    NuGet audit suppressions (ADR-0024, the pattern of Tandem ADR-0014). NuGet audit runs on every restore, and its
    warnings are errors. An advisory may be suppressed only when it comes transitively through a package whose
    version the host site controls (Umbraco CMS), never for a package Jiron Form Builder references directly
    (scripts/check-audit-suppressions.mjs guards that, and the host-only group below). Each entry names exactly one
    reviewed advisory URL and its package; any advisory not listed here fails the build.

    Reviewed 2026-10-27 (step 5.5a, ADR-0074) at the packages' floor, CMS 17.6.0, and at the hosts' 17.7.1; first
    reviewed in step 3.1. Review the list at every phase review and in 16.1, and remove an entry as soon as neither
    version brings the affected package version any more.
  -->
  <ItemGroup>
    <!-- MessagePack 3.1.8 (17.6.0 and 17.7.1), via Umbraco.Cms.Web.Common, Api.Common and Api.Delivery. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" Package="MessagePack" />

    <!--
      System.Security.Cryptography.Pkcs 10.0.0 and 10.0.10 (.NET servicing), via MailKit and MimeKit in
      Umbraco.Cms.Infrastructure, and via Examine's Data Protection in Umbraco.Cms.Web.Common.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" Package="System.Security.Cryptography.Pkcs" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" Package="System.Security.Cryptography.Pkcs" />

    <!--
      System.Security.Cryptography.Xml 10.0.10 (.NET servicing), via Examine's Data Protection in
      Umbraco.Cms.Web.Common and Api.Common.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7hqp-7c5m-4vq6" Package="System.Security.Cryptography.Xml" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-c399-9853-6jmj" Package="System.Security.Cryptography.Xml" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-r955-8q5j-3h83" Package="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <!--
    Umbraco hosts only (the integration tests now, the demo from 3.3): projects that run a whole site set
    JfbUmbracoHost. None of Jiron Form Builder's packages brings ImageSharp, so these entries never cover them:
    if a package ever did, its restore would fail. Items are evaluated after every property, so the project's own
    setting counts here.
  -->
  <ItemGroup Condition="'$(JfbUmbracoHost)' == 'true'">
    <!-- SixLabors.ImageSharp 3.1.12, via Umbraco.Cms (Umbraco.Cms.Imaging.ImageSharp) 17.7.1. Never reference it directly. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" Package="SixLabors.ImageSharp" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" Package="SixLabors.ImageSharp" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" Package="SixLabors.ImageSharp" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" Package="SixLabors.ImageSharp" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" Package="SixLabors.ImageSharp" />
    <!-- Added 2026-10-27 (step 5.5a), published 2026-10-07 for the same 3.1.12; ImageSharp 3.2.0 fixes it. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" Package="SixLabors.ImageSharp" />
  </ItemGroup>

</Project>
