<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every rule of the product (ADR-0001): definitions, registries, the rule, validation and merge-tag engines, entries,
    actions and the outbox, settings, permissions, privacy, persistence and jobs. Core knows nothing about HTTP: it
    references no ASP.NET Core HTTP, MVC, routing or Razor assembly and no Umbraco web or API package, which an
    architecture test checks (3.4).
  -->
  <PropertyGroup>
    <Title>Jiron Form Builder Core</Title>
    <Description>The domain of Jiron Form Builder for Umbraco 17: form definitions, rules, validation, entries, actions, settings and persistence. Sites install Jiron.Umbraco.FormBuilder, which brings this package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The shared logic (Logic/) is internal until its engines get public interfaces, and Web uses it. The test
      projects see internals through src/Directory.Build.props.
    -->
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Web" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The appsettings schema for IntelliSense, generated by AppSettingsSchemaTests (ADR-0042), and the props file that
      adds it to the site's schema through Umbraco's UmbracoJsonSchemaFiles.
    -->
    <None Include="appsettings-schema.Jiron.Umbraco.FormBuilder.json" Pack="true" PackagePath="" />
    <None Include="buildTransitive/Jiron.Umbraco.FormBuilder.Core.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- The built-in templates, as export envelopes inside the assembly (ADR-0046). -->
    <None Remove="Forms/Templates/*.json" />
    <EmbeddedResource Include="Forms/Templates/*.json" LogicalName="Jiron.Umbraco.FormBuilder.Core.Forms.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The words of the standard option lists, one language table per language (ADR-0073). -->
    <None Remove="OptionLists/lang/*.json" />
    <EmbeddedResource Include="OptionLists/lang/*.json" LogicalName="Jiron.Umbraco.FormBuilder.Core.OptionLists.lang.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
