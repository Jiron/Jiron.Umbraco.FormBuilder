<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every rule of the product (ADR-0001): definitions, registries, the rule, validation and merge-tag engines, entries,
    actions and the outbox, settings, permissions, privacy, persistence and jobs. Core knows nothing about HTTP: it
    references no ASP.NET Core HTTP, MVC, routing or Razor assembly and no Umbraco web or API package, which an
    architecture test checks (3.4).
  -->
  <PropertyGroup>
    <Title>Jiron Form Builder Core</Title>
    <Description>The domain of Jiron Form Builder for Umbraco 17: form definitions, rules, validation, entries, actions, settings and persistence. Sites install Jiron.Umbraco.FormBuilder, which brings this package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Web" />
    <!-- The shared logic (Logic/) is internal until its engines get public interfaces; the vector runners test it. -->
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Tests.Unit" />
  </ItemGroup>

</Project>
