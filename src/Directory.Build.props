<Project>

  <!-- The packages that ship to sites (ADR-0001). The repository-wide settings come first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Every package's metadata (§3.5, ADR-0246); each project adds its Title and Description, and the two packages a site
    installs (the meta package and the AI add-on) their Marketplace tags. Every package carries the NuGet readme and the
    icon: docs/README.nuget.md, which the AI add-on replaces with its own, and the colour mark at 128 px.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <PackageTags>umbraco</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <JfbPackageReadme Condition="'$(JfbPackageReadme)' == ''">$(MSBuildThisFileDirectory)..\docs\README.nuget.md</JfbPackageReadme>
    <!-- The Marketplace reads umbraco-marketplace.json from here, once the repository is public (OWNER-TODO). -->
    <PackageProjectUrl>https://github.com/Jiron/Jiron.Umbraco.FormBuilder</PackageProjectUrl>
    <!--
      PolyForm Perimeter 1.0.1 has no SPDX id, so the licence is the packed LICENSE.md, and acceptance is required as a
      visible signal of a licence that is not a standard one (§3.5).
    -->
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <!-- Symbols as a .snupkg next to each package, with Source Link to the commit (built into the SDK). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Checks the package's assets on every pack; a baseline version follows the first published release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <!-- Items are evaluated after every property, so a project's own JfbPackageReadme counts here. -->
    <None Include="$(JfbPackageReadme)" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <!--
    Tests may see internals; NSubstitute needs DynamicProxyGenAssembly2 to substitute internal interfaces. The demo's
    seeder creates its forms through the form service as an editor would (ADR-0094); the demo is never packed.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Tests.Unit" />
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Tests.Integration" />
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Tests.AI" />
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Testing" />
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Demo" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
