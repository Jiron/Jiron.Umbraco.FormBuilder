<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The HTTP surfaces, rendering and static assets (ADR-0001): the public and management APIs, the view component,
    tag helpers and surface controller, themes, the form picker, health checks and the files built from Client/.
    Based on Umbraco's umbraco-extension template (17.7.1, `-ex -pm Central`), restructured (ADR-0025): a Razor class
    library serving wwwroot from the site root, so the backoffice lives under /App_Plugins/JironFormBuilder/ and the
    website assets under /jfb/assets/.
  -->
  <PropertyGroup>
    <Title>Jiron Form Builder Web</Title>
    <Description>The public and management APIs, form rendering, themes and the Forms section of Jiron Form Builder for Umbraco 17. Sites install Jiron.Umbraco.FormBuilder, which brings this package.</Description>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- The form views under Views/JironFormBuilder/ are compiled into this assembly (ADR-0093). -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Api.Delivery" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jiron.Umbraco.FormBuilder.Core\Jiron.Umbraco.FormBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The client sources are built into wwwroot/App_Plugins/JironFormBuilder (the backoffice, static web assets) and
      WebsiteAssets (embedded, below); the sources themselves are never packed (ADR-0026).
    -->
    <Content Remove="Client\**" />
    <None Remove="Client\**" />
    <None Remove="WebsiteAssets\**" />
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!--
    The website assets (the runtime, the element and, from 6.3, the themes) are embedded in this assembly with the
    Brotli and gzip copies the client build writes, as jfb/assets/<path>, and served from there by Jiron Form Builder's
    own asset endpoint (6.2, ADR-0026). They are no static web assets: packed that way, the SDK records each copy's
    file with this machine's absolute path, and every site that installs the package then fails to build.
  -->
  <Target Name="JfbEmbedWebsiteAssets" BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <_JfbWebsiteAsset Include="WebsiteAssets\**\*" />
      <EmbeddedResource Include="@(_JfbWebsiteAsset)" LogicalName="jfb/assets/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

  <!--
    The built client assets are not committed (ADR-0001), so packing checks that they exist, match the current Client
    sources, were built for this package's version, carry the licence banner and their compressed copies, and hold no
    source map, and that the assembly to be packed embeds them as they are now (JFB001, ADR-0026).
    scripts/pack.mjs builds them for the version it packs.
  -->
  <Target Name="JfbCheckClientAssets" BeforeTargets="GenerateNuspec">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)Client/scripts/stamp.mjs&quot; check &quot;$(PackageVersion)&quot; &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
