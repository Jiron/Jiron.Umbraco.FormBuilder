{
  "name": "@jfb/logic",
  "private": true,
  "type": "module",
  "description": "Rules, validation and merge tags in TypeScript (ROADMAP section 4.2, ADR-0005): no DOM, no dependencies. The runtime, the element and the backoffice bundle it from source, so it has no build of its own. Its sources import each other with the .ts extension, so Node runs the tables tool on them as they are.",
  "exports": {
    ".": "./src/index.ts",
    "./calc": "./src/calc.ts",
    "./files": "./src/file-kinds.ts",
    "./proto": "./src/proto.ts",
    "./recall": "./src/recall.ts",
    "./signature": "./src/typed-name.ts",
    "./template": "./src/template.ts",
    "./lang/en": "./src/lang/messages.en.ts",
    "./lang/de": "./src/lang/messages.de.ts",
    "./lang/fr": "./src/lang/messages.fr.ts",
    "./lang/it": "./src/lang/messages.it.ts",
    "./lang/nl": "./src/lang/messages.nl.ts",
    "./lang/es": "./src/lang/messages.es.ts",
    "./lang/da": "./src/lang/messages.da.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "tables": "node tools/unicode-tables.ts",
    "words": "node tools/message-words.ts"
  }
}
