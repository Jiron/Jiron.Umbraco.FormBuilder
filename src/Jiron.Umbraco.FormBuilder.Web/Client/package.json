{
  "name": "jfb-client",
  "private": true,
  "type": "module",
  "description": "Jiron Form Builder's client packages (ADR-0026): the shared logic, the website runtime, the headless element and the backoffice extension, built into ../wwwroot/App_Plugins/JironFormBuilder and ../WebsiteAssets.",
  "license": "SEE LICENSE IN ../../../LICENSE.md",
  "workspaces": [
    "packages/logic",
    "packages/runtime",
    "packages/element",
    "packages/backoffice"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.config.json",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build --workspaces --if-present && node scripts/compress.mjs && node scripts/stamp.mjs write",
    "check-build": "node scripts/stamp.mjs check",
    "size": "node ../../../scripts/size-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.19.1",
    "@umbraco-cms/backoffice": "17.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    },
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
