@* jfb-view: Progress 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.ProgressViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@if (Model.Style == ProgressStyle.Bar)
{
    <div class="jfb-progress jfb-progress-bar">
        <p class="jfb-progress-text" id="@Model.TextId">@Model.Text</p>
        <progress max="@Model.Total" value="@Model.Current" aria-labelledby="@Model.TextId">@Model.Text</progress>
    </div>
}
else
{
    <div class="jfb-progress jfb-progress-steps">
        <p class="jfb-progress-text">@Model.Text</p>
        <ol aria-label="@Model.Label">
            @foreach (var step in Model.Steps)
            {
                <li aria-current="@(step.IsCurrent ? "step" : null)" @FormBuilderHtml.Flag("data-jfb-done", step.IsDone)><span>@step.Title</span></li>
            }
        </ol>
    </div>
}
