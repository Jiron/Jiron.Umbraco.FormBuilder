@* jfb-view: Form 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FormViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@if (Model.Display == FormDisplay.Form)
{
    <form class="@Model.CssClass" id="@Model.Id" data-jfb-form="@Model.Key" data-jfb-revision="@Model.Revision" data-jfb-api="@Model.ApiBase" @FormBuilderHtml.Flag("data-jfb-light-only", Model.IsLightOnly) @FormBuilderHtml.Attribute("data-jfb-content", Model.ContentKey?.ToString("D")) @FormBuilderHtml.Attribute("data-jfb-placement", Model.Placement) @FormBuilderHtml.Flag("data-jfb-asks", Model.AsksAtOnce) @FormBuilderHtml.Flag("data-jfb-posted", Model.IsPosted) @FormBuilderHtml.Attribute("data-jfb-insights", Model.InsightsUrl) data-jfb-contract="@FormViewModel.ContractVersion" lang="@Model.Culture" dir="@Model.Direction" method="post" action="@Model.Action" enctype="@Model.EncodingType" novalidate>
        <script type="application/json" data-jfb-model>@Model.ModelData</script>
        @* What the runtime shows errors (ADR-0113) and a send (ADR-0120) with: the theme's summary for one link, its error paragraph, its notices and its outcome; a template's content is inert. *@
        <template data-jfb-templates @FormBuilderHtml.Attribute("data-jfb-sending", Model.Sending?.SendingText) @FormBuilderHtml.Attribute("data-jfb-thanks", Model.Sending?.ThanksText)>
            @if (Model.ErrorSummaryTemplate is { } template)
            {
                @await Html.PartialAsync(Model.Views.ErrorSummary, template)
            }
            <p class="@Model.Classes.Error" data-jfb-error></p>
            @if (Model.Sending is { } sending)
            {
                foreach (var refused in sending.Notices)
                {
                    @await Html.PartialAsync(Model.Views.Notice, refused)
                }
                @await Html.PartialAsync(Model.Views.Outcome, sending.Outcome)
                if (sending.Moves is { } moves)
                {
                    @await Html.PartialAsync(Model.Views.Navigation, moves)
                }
            }
            @if (Model.Resume is { } saved)
            {
                @await Html.PartialAsync(Model.Views.Notice, saved.Saved)
                @await Html.PartialAsync(Model.Views.Notice, saved.Restored)
                @await Html.PartialAsync(Model.Views.Notice, saved.Expired)
            }
        </template>
        @* Save and continue later (ADR-0163): the link button the runtime puts with the buttons, and the panel it shows in their place; a view without it offers none. *@
        @if (Model.Resume is { } resume)
        {
            <template data-jfb-resume data-jfb-saving="@resume.SavingText" data-jfb-invalid="@resume.InvalidText" data-jfb-failed="@resume.FailedText">
                <button type="button" class="@Model.Classes.ButtonLink" data-jfb-save-open>@resume.OpenLabel</button>
                <div class="@resume.PanelClass" role="group" aria-labelledby="@(Model.Id)-save-title" data-jfb-save>
                    <h2 id="@(Model.Id)-save-title">@resume.OpenLabel</h2>
                    <p>@resume.Intro</p>
                    <div class="@resume.FieldClass">
                        <label class="@Model.Classes.Label" for="@(Model.Id)-save">@resume.EmailLabel</label>
                        <input class="@Model.Classes.Control" type="email" id="@(Model.Id)-save" autocomplete="email" spellcheck="false" aria-describedby="@(Model.Id)-save-error">
                        <p class="@Model.Classes.Error" id="@(Model.Id)-save-error" hidden></p>
                    </div>
                    <div class="@Model.Classes.Navigation">
                        <button type="button" class="@Model.Classes.ButtonPrimary" data-jfb-save-send>@resume.SendLabel</button>
                        <button type="button" class="@Model.Classes.Button" data-jfb-save-close>@resume.CancelLabel</button>
                    </div>
                </div>
            </template>
        }
        @if (Model.DefaultButton is { } first)
        {
            <button type="submit" class="jfb-visually-hidden" name="jfb-nav" value="@first.Value" tabindex="-1" aria-hidden="true">@first.Label</button>
        }
        @if (Model.Progress is { } progress)
        {
            @await Html.PartialAsync(Model.Views.Progress, progress)
        }
        @if (Model.Notice is { } notice)
        {
            @await Html.PartialAsync(Model.Views.Notice, notice)
        }
        @if (Model.ErrorSummary is { } summary)
        {
            @await Html.PartialAsync(Model.Views.ErrorSummary, summary)
        }
        @if (Model.RequiredNote is { } note)
        {
            <p class="@Model.Classes.Help" hidden="@Model.IsRequiredNoteHidden" @FormBuilderHtml.Flag("data-jfb-required-note", Model.Hooks)>@note</p>
        }
        @foreach (var page in Model.Pages)
        {
            @await Html.PartialAsync(Model.Views.Page, page)
        }
        @if (Model.Navigation is { } navigation)
        {
            @await Html.PartialAsync(Model.Views.Navigation, navigation)
        }
        @foreach (var input in Model.ContextValues)
        {
            <input type="hidden" name="@input.Name" value="@input.Value">
        }
        @foreach (var input in Model.PostValues)
        {
            <input type="hidden" name="@input.Name" value="@input.Value">
        }
        @if (Model.Honeypot is { } honeypot)
        {
            <div class="jfb-hp" aria-hidden="true">
                <label for="@honeypot.Id">@honeypot.Label</label>
                <input type="text" id="@honeypot.Id" name="@honeypot.Name" tabindex="-1" autocomplete="off">
            </div>
        }
        <div data-jfb-live aria-live="polite"></div>
    </form>
}
else
{
    <div class="@Model.CssClass" id="@Model.Id" data-jfb-form="@Model.Key" @FormBuilderHtml.Flag("data-jfb-light-only", Model.IsLightOnly) data-jfb-contract="@FormViewModel.ContractVersion" lang="@Model.Culture" dir="@Model.Direction">
        @if (Model.Outcome is { } outcome)
        {
            @await Html.PartialAsync(Model.Views.Outcome, outcome)
        }
        else if (Model.Notice is { } notice)
        {
            @await Html.PartialAsync(Model.Views.Notice, notice)
        }
    </div>
}
