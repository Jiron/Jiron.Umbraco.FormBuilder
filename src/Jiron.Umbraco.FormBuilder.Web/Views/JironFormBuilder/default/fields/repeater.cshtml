@* jfb-view: fields/repeater 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@*
    The rows in the field's fieldset, each a fieldset with its legend and its fields; the container carries the field's
    id, so the error summary's link to the group's own error moves the focus to its rows. Add and Remove are submit
    buttons, so a page without JavaScript adds or removes a row by rendering the page again, opened at the row added or
    at the group.
*@
@{
    var control = (RepeaterControlModel)Model.Control!;
    void Remove(RowButtonModel remove)
    {
        if (remove.Context is { } context)
        {
            <button type="submit" class="@Model.Classes.ButtonLink" name="jfb-nav" value="@remove.Value" formaction="@remove.Action" disabled="@Model.IsDisabled">@remove.Text<span class="jfb-visually-hidden"> @context</span></button>
        }
        else
        {
            <button type="submit" class="@Model.Classes.ButtonLink" name="jfb-nav" value="@remove.Value" formaction="@remove.Action" disabled="@Model.IsDisabled">@remove.Text</button>
        }
    }
}
<div class="jfb-repeater" id="@Model.Id" tabindex="-1">
    <input type="hidden" name="@control.RowCount.Name" value="@control.RowCount.Value" disabled="@Model.IsDisabled">
    @foreach (var row in control.Rows)
    {
        <fieldset class="jfb-row" id="@row.Id" data-jfb-row="@row.Index">
            <legend>@row.Legend</legend>
            @if (row.Remove is { } remove)
            {
                Remove(remove);
            }
            <div class="@control.FieldsCssClass">
                @foreach (var field in row.Fields)
                {
                    @await Html.PartialAsync(control.FieldView, field)
                }
            </div>
        </fieldset>
    }
    @if (control.Add is { } add)
    {
        <button type="submit" class="@Model.Classes.Button" name="jfb-nav" value="@add.Value" formaction="@add.Action" disabled="@Model.IsDisabled"><span class="jfb-icon jfb-icon-add" aria-hidden="true"></span>@add.Text</button>
    }
</div>
