@* jfb-view: fields/consent 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* The box with the wording it shows, and the wording's hash, which the entry stores with the tick (ADR-0009). *@
@{
    var control = (SingleChoiceControlModel)Model.Control!;
}
<div class="@Model.Classes.Choice">
    <input class="@Model.Classes.ChoiceInput" type="checkbox" id="@Model.Id" name="@Model.Name" value="@control.Value" checked="@control.IsChecked" required="@Model.IsRequired" disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
    @if (Model.Mark == FieldMark.Required)
    {
        <label class="@Model.Classes.ChoiceLabel" for="@Model.Id">@control.Label <span class="jfb-mark" aria-hidden="true">@Model.MarkText</span></label>
    }
    else
    {
        <label class="@Model.Classes.ChoiceLabel" for="@Model.Id">@control.Label</label>
    }
</div>
@if (control.Wording is { } wording)
{
    <input type="hidden" name="@wording.Name" value="@wording.Value" disabled="@Model.IsDisabled">
}
