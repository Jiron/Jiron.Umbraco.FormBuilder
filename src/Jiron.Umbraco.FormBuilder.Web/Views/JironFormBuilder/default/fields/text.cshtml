@* jfb-view: fields/text 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var control = (TextControlModel)Model.Control!;
    void Input()
    {
        <input class="jfb-control" type="@control.InputType" id="@Model.Id" name="@Model.Name" value="@(Model.Value.Length == 0 ? null : Model.Value)" placeholder="@Model.Placeholder" autocomplete="@Model.Autocomplete" spellcheck="@(control.Spellcheck is { } check ? (check ? "true" : "false") : null)" required="@Model.IsRequired" disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
    }
}
@if (control.Prefix is null && control.Suffix is null)
{
    Input();
}
else
{
    <div class="jfb-affix">
        @if (control.Prefix is { } prefix)
        {
            <span id="@prefix.Id">@prefix.Text</span>
        }
        @{ Input(); }
        @if (control.Suffix is { } suffix)
        {
            <span id="@suffix.Id">@suffix.Text</span>
        }
    </div>
}
@if (control.Counter is { } counter)
{
    <p class="jfb-counter" id="@counter.Id">@counter.Text</p>
}
