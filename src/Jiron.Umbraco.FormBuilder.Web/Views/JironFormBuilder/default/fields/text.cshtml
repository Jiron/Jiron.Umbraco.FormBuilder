@* jfb-view: fields/text 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var control = (TextControlModel)Model.Control!;
    void Input()
    {
        <input class="@Model.Classes.Control" type="@control.InputType" id="@Model.Id" name="@Model.Name" value="@(Model.Value.Length == 0 ? null : Model.Value)" placeholder="@Model.Placeholder" @FormBuilderHtml.Text(Model, "placeholder") autocomplete="@Model.Autocomplete" spellcheck="@(control.Spellcheck is { } check ? (check ? "true" : "false") : null)" required="@Model.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", Model.Hooks) disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
    }
}
@if (control.Prefix is null && control.Suffix is null)
{
    Input();
}
else
{
    <div class="@Model.Classes.Affix">
        @if (control.Prefix is { } prefix)
        {
            <span class="@Model.Classes.AffixText" id="@prefix.Id">@prefix.Text</span>
        }
        @{ Input(); }
        @if (control.Suffix is { } suffix)
        {
            <span class="@Model.Classes.AffixText" id="@suffix.Id">@suffix.Text</span>
        }
    </div>
}
@if (control.Counter is { } counter)
{
    <p class="@Model.Classes.Counter" id="@counter.Id" data-jfb-limit="@counter.Limit" data-jfb-left="@counter.Left" data-jfb-left-one="@counter.LeftOne" data-jfb-too-many="@counter.Over" data-jfb-too-many-one="@counter.OverOne">@counter.Text</p>
}
