@* jfb-view: fields/scale 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@*
    The words at the ends show below the numbers; screen readers hear them with the first and the last number, whose
    whole name is in one hidden span ("0, Not likely") with the shown number kept from them: a visually hidden span
    counts as a block, so browsers would otherwise put a space before its comma.
*@
@{
    var control = (ChoicesControlModel)Model.Control!;
}
<div class="jfb-scale">
    <div class="@control.CssClass">
        @foreach (var choice in control.Choices)
        {
            <div class="@Model.Classes.Choice">
                <input class="@Model.Classes.ChoiceInput" type="radio" id="@choice.Id" name="@Model.Name" value="@choice.Value" checked="@choice.IsChecked" required="@Model.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", Model.Hooks) disabled="@Model.IsDisabled" aria-invalid="@(Model.ChoiceErrorId is null ? null : "true")" aria-describedby="@Model.ChoiceErrorId">
                @if (choice.HiddenText is { } hidden)
                {
                    <label class="@Model.Classes.ChoiceLabel" for="@choice.Id"><span aria-hidden="true">@choice.Label</span><span class="jfb-visually-hidden">@choice.Label@hidden</span></label>
                }
                else
                {
                    <label class="@Model.Classes.ChoiceLabel" for="@choice.Id">@choice.Label</label>
                }
            </div>
        }
    </div>
    @if (control.Ends is { } ends)
    {
        <div class="jfb-ends" aria-hidden="true"><span>@ends.Low</span> <span>@ends.High</span></div>
    }
</div>
