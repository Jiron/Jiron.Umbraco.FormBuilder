@* jfb-view: fields/yesno 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* Two buttons in the field's fieldset, or one switch with its own label, which posts nothing while it is off. *@
@if (Model.Control is SingleChoiceControlModel box)
{
    <div class="@Model.Classes.SwitchChoice">
        <input type="checkbox" role="switch" class="@Model.Classes.SwitchInput" id="@Model.Id" name="@Model.Name" value="@box.Value" checked="@box.IsChecked" disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
        <label class="@Model.Classes.ChoiceLabel" for="@Model.Id">@box.Label</label>
    </div>
}
else
{
    var control = (ChoicesControlModel)Model.Control!;
    <div class="@control.CssClass">
        @foreach (var choice in control.Choices)
        {
            <div class="@Model.Classes.Choice">
                <input class="@Model.Classes.ChoiceInput" type="radio" id="@choice.Id" name="@Model.Name" value="@choice.Value" checked="@choice.IsChecked" required="@Model.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", Model.Hooks) disabled="@Model.IsDisabled">
                <label class="@Model.Classes.ChoiceLabel" for="@choice.Id">@choice.Label</label>
            </div>
        }
    </div>
}
