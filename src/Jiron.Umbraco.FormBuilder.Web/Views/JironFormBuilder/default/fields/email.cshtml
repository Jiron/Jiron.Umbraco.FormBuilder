@* jfb-view: fields/email 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var control = (TextControlModel)Model.Control!;
}
<input class="@Model.Classes.Control" type="email" id="@Model.Id" name="@Model.Name" value="@(Model.Value.Length == 0 ? null : Model.Value)" placeholder="@Model.Placeholder" @FormBuilderHtml.Text(Model, "placeholder") autocomplete="@Model.Autocomplete" spellcheck="false" required="@Model.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", Model.Hooks) disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
@if (control.Confirm is { } confirm)
{
    <label class="@Model.Classes.Label" for="@confirm.Id">@confirm.Label@FormBuilderHtml.Mark(Model)</label>
    <input class="@Model.Classes.Control" type="email" id="@confirm.Id" name="@confirm.Name" value="@(confirm.Value.Length == 0 ? null : confirm.Value)" autocomplete="@Model.Autocomplete" spellcheck="false" required="@Model.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", Model.Hooks) disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@(Model.Error is null ? null : Model.ErrorId)">
}
