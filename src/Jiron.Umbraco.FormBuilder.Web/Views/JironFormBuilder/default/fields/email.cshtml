@* jfb-view: fields/email 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var control = (TextControlModel)Model.Control!;
}
<input class="jfb-control" type="email" id="@Model.Id" name="@Model.Name" value="@(Model.Value.Length == 0 ? null : Model.Value)" placeholder="@Model.Placeholder" autocomplete="@Model.Autocomplete" spellcheck="false" required="@Model.IsRequired" disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
@if (control.Confirm is { } confirm)
{
    switch (Model.Mark)
    {
        case FieldMark.Optional:
            <label class="jfb-label" for="@confirm.Id">@confirm.Label <span class="jfb-mark">@Model.MarkText</span></label>
            break;
        case FieldMark.Required:
            <label class="jfb-label" for="@confirm.Id">@confirm.Label <span class="jfb-mark" aria-hidden="true">@Model.MarkText</span></label>
            break;
        default:
            <label class="jfb-label" for="@confirm.Id">@confirm.Label</label>
            break;
    }
    <input class="jfb-control" type="email" id="@confirm.Id" name="@confirm.Name" value="@(confirm.Value.Length == 0 ? null : confirm.Value)" autocomplete="@Model.Autocomplete" spellcheck="false" required="@Model.IsRequired" disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@(Model.Error is null ? null : Model.ErrorId)">
}
