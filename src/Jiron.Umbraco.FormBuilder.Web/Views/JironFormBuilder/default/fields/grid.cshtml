@* jfb-view: fields/grid 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* The columns show once above the rows for sight; each row is a fieldset whose inputs carry their column in a label. *@
@{
    var control = (GridControlModel)Model.Control!;
}
@if (control.Empty is { } empty)
{
    <p class="jfb-help" id="@Model.Id">@empty</p>
}
else
{
    <div class="jfb-matrix">
        <div class="jfb-matrix-head" aria-hidden="true">
            <span></span>
            <div>
                @foreach (var column in control.Columns)
                {
                    <span>@column</span>
                }
            </div>
        </div>
        @foreach (var row in control.Rows)
        {
            <fieldset>
                @if (row.Mark == FieldMark.Required)
                {
                    <legend>@row.Label <span class="jfb-mark" aria-hidden="true">@row.MarkText</span></legend>
                }
                else
                {
                    <legend>@row.Label</legend>
                }
                <div class="jfb-choices">
                    @foreach (var choice in row.Choices)
                    {
                        <div class="jfb-choice">
                            <input type="@control.InputType" id="@choice.Id" name="@row.Name" value="@choice.Value" checked="@choice.IsChecked" required="@(row.IsRequired && control.InputType == "radio")" disabled="@Model.IsDisabled">
                            <label for="@choice.Id"><span>@choice.Label</span></label>
                        </div>
                    }
                </div>
            </fieldset>
        }
    </div>
}
