@* jfb-view: fields/calculation 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* The result as the server works it out for the page's answers; the runtime works it out again as the visitor answers. *@
@{
    var control = (CalculationControlModel)Model.Control!;
}
<output class="jfb-output" id="@Model.Id" name="@Model.Name" aria-describedby="@Model.DescribedBy">@control.Text</output>
