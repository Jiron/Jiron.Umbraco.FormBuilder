@* jfb-view: fields/file 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@*
    The files an earlier post stored, each a ticked box that posts its token, then the browser's own file input; the
    runtime adds the drop zone's buttons and the chosen files (data-jfb-enhanced).
*@
@{
    var control = (FileControlModel)Model.Control!;
}
@if (control.Kept.Count > 0)
{
    <div class="jfb-choices jfb-files">
        @foreach (var kept in control.Kept)
        {
            <div class="jfb-choice">
                <input type="checkbox" id="@kept.Id" name="@Model.Name" value="@kept.Token" checked disabled="@Model.IsDisabled">
                <label for="@kept.Id">@kept.Label</label>
            </div>
        }
    </div>
}
<div class="jfb-upload" @FormBuilderHtml.Flag("data-jfb-dropzone", control.DropZone)>
    <span class="jfb-icon jfb-icon-upload" aria-hidden="true"></span>
    <div class="jfb-upload-actions">
        <input type="file" id="@Model.Id" name="@Model.Name" accept="@control.Accept" multiple="@control.Multiple" required="@Model.IsRequired" disabled="@Model.IsDisabled" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
    </div>
</div>
