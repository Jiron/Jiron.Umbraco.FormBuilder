@* jfb-view: fields/checkboxes 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* Each box repeats the field's name; none is required, as the server counts the boxes ticked. *@
@{
    var control = (ChoicesControlModel)Model.Control!;
    void Choice(ChoiceModel choice, bool sample = false)
    {
        <div class="@Model.Classes.Choice" @FormBuilderHtml.Flag("data-jfb-sample", sample)>
            @if (choice.Image is { } image)
            {
                <img src="@image.Url" alt="" width="@image.Width" height="@image.Height">
            }
            <input class="@Model.Classes.ChoiceInput" type="checkbox" id="@choice.Id" name="@Model.Name" value="@choice.Value" checked="@choice.IsChecked" disabled="@Model.IsDisabled" aria-invalid="@(Model.ChoiceErrorId is null ? null : "true")" aria-describedby="@FormBuilderHtml.Ids(choice.Description is null ? null : choice.DescriptionId, Model.ChoiceErrorId)">
            <label class="@Model.Classes.ChoiceLabel" for="@choice.Id">@choice.Label</label>
            @if (choice.Description is not null)
            {
                <p class="@Model.Classes.Help" id="@choice.DescriptionId">@choice.Description</p>
            }
        </div>
    }
}
@if (control.Empty is { } empty)
{
    <p class="@Model.Classes.Help" id="@Model.Id">@empty</p>
}
else
{
    <div class="@control.CssClass">
        @foreach (var choice in control.Choices)
        {
            Choice(choice);
        }
        @if (control.Other is { } other)
        {
            Choice(other.Choice);
            <div class="jfb-other">
                <label class="jfb-visually-hidden" for="@other.TextId">@other.TextLabel</label>
                <input class="@Model.Classes.Control" id="@other.TextId" name="@other.TextName" value="@(other.Text.Length == 0 ? null : other.Text)" disabled="@Model.IsDisabled">
            </div>
        }
    </div>
}
@if (control.Cascade is { } cascade)
{
    <template data-jfb-cascade data-jfb-none="@cascade.None" data-jfb-unavailable="@cascade.Unavailable">
        <div class="@control.CssClass">
            @{ Choice(cascade.Sample, true); }
            @if (control.Other is { } last)
            {
                Choice(last.Choice);
                <div class="jfb-other">
                    <label class="jfb-visually-hidden" for="@last.TextId">@last.TextLabel</label>
                    <input class="@Model.Classes.Control" id="@last.TextId" name="@last.TextName" disabled="@Model.IsDisabled">
                </div>
            }
        </div>
        <p class="@Model.Classes.Help" id="@Model.Id"></p>
    </template>
}
