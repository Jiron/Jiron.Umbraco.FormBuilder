@* jfb-view: fields/radio 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var control = (ChoicesControlModel)Model.Control!;
    void Choice(ChoiceModel choice)
    {
        <div class="@Model.Classes.Choice">
            @if (choice.Image is { } image)
            {
                <img src="@image.Url" alt="" width="@image.Width" height="@image.Height">
            }
            <input class="@Model.Classes.ChoiceInput" type="radio" id="@choice.Id" name="@Model.Name" value="@choice.Value" checked="@choice.IsChecked" required="@Model.IsRequired" disabled="@Model.IsDisabled" aria-describedby="@(choice.Description is null ? null : choice.DescriptionId)">
            <label class="@Model.Classes.ChoiceLabel" for="@choice.Id">@choice.Label</label>
            @if (choice.Description is not null)
            {
                <p class="@Model.Classes.Help" id="@choice.DescriptionId">@choice.Description</p>
            }
        </div>
    }
}
@if (control.Empty is { } empty)
{
    <p class="@Model.Classes.Help" id="@Model.Id">@empty</p>
}
else
{
    <div class="@control.CssClass">
        @foreach (var choice in control.Choices)
        {
            Choice(choice);
        }
        @if (control.Other is { } other)
        {
            Choice(other.Choice);
            <div class="jfb-other">
                <label class="jfb-visually-hidden" for="@other.TextId">@other.TextLabel</label>
                <input class="@Model.Classes.Control" id="@other.TextId" name="@other.TextName" value="@(other.Text.Length == 0 ? null : other.Text)" disabled="@Model.IsDisabled">
            </div>
        }
    </div>
}
