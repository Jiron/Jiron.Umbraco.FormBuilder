@* jfb-view: fields/address 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* The parts in the field's fieldset, which names its help and its error; each part has its own label and input. *@
@{
    var control = (PartsControlModel)Model.Control!;
}
<div class="jfb-parts">
    @foreach (var part in control.Parts)
    {
        <div class="@(part.IsWide ? "jfb-part jfb-part-wide" : "jfb-part")">
            <label class="@Model.Classes.PartLabel" for="@part.Id">@part.Label@FormBuilderHtml.Mark(part)</label>
            @if (part.Countries is { } countries)
            {
                <div class="jfb-select">
                    <select class="@Model.Classes.Select" id="@part.Id" name="@part.Name" autocomplete="@part.Autocomplete" required="@part.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", part.FollowsRequired) disabled="@Model.IsDisabled" aria-invalid="@(part.IsInvalid ? "true" : null)">
                        <option value="">@countries.Prompt</option>
                        @foreach (var option in countries.Options)
                        {
                            <option value="@option.Value" selected="@option.IsSelected">@option.Label</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input class="@Model.Classes.Control" id="@part.Id" name="@part.Name" value="@(part.Value.Length == 0 ? null : part.Value)" autocomplete="@part.Autocomplete" autocapitalize="@(part.Part == "postcode" ? null : "words")" spellcheck="false" required="@part.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", part.FollowsRequired) disabled="@Model.IsDisabled" aria-invalid="@(part.IsInvalid ? "true" : null)">
            }
        </div>
    }
</div>
