@* jfb-view: fields/dropdown 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* A dropdown in jfb-select for the theme's chevron, or a list box that takes several choices with how to choose them. *@
@{
    var control = (SelectControlModel)Model.Control!;
    void Select()
    {
        <select class="jfb-control" id="@Model.Id" name="@Model.Name" multiple="@control.Multiple" size="@control.Size" autocomplete="@Model.Autocomplete" required="@Model.IsRequired" disabled="@(Model.IsDisabled || control.Empty is not null)" aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
            @if (control.Empty is { } empty)
            {
                <option value="">@empty</option>
            }
            else
            {
                if (control.Prompt is { } prompt)
                {
                    <option value="">@prompt</option>
                }
                foreach (var option in control.Options)
                {
                    <option value="@option.Value" selected="@option.IsSelected">@option.Label</option>
                }
            }
        </select>
    }
}
@if (control.Multiple)
{
    if (control.Hint is { } hint)
    {
        <p class="jfb-help" id="@hint.Id">@hint.Text</p>
    }
    Select();
}
else
{
    <div class="jfb-select">
        @{ Select(); }
    </div>
}
