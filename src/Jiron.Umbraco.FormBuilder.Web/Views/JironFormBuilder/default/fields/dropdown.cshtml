@* jfb-view: fields/dropdown 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@* A dropdown in jfb-select for the theme's chevron, or a list box that takes several choices with how to choose them. *@
@{
    var control = (SelectControlModel)Model.Control!;
    void Select()
    {
        <select class="@Model.Classes.Select" id="@Model.Id" name="@Model.Name" multiple="@control.Multiple" size="@control.Size" @FormBuilderHtml.Flag("data-jfb-cascade", control.Cascades) @FormBuilderHtml.Attribute("data-jfb-prompt", control.Cascades ? control.Prompt : null) @FormBuilderHtml.Attribute("data-jfb-none", control.Cascades ? control.None : null) @FormBuilderHtml.Attribute("data-jfb-unavailable", control.Cascades ? control.Unavailable : null) autocomplete="@Model.Autocomplete" required="@Model.IsRequired" @FormBuilderHtml.Flag("data-jfb-requires", Model.Hooks) disabled="@(Model.IsDisabled || control.Empty is not null)" @FormBuilderHtml.Flag("data-jfb-disabled", Model.Hooks && control.Empty is not null) aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@Model.DescribedBy">
            @if (control.Empty is { } empty)
            {
                <option value="">@empty</option>
            }
            else
            {
                if (control.Prompt is { } prompt)
                {
                    <option value="">@prompt</option>
                }
                foreach (var option in control.Options)
                {
                    <option value="@option.Value" selected="@option.IsSelected">@option.Label</option>
                }
            }
        </select>
    }
}
@if (control.Multiple)
{
    if (control.Hint is { } hint)
    {
        <p class="@Model.Classes.Help" id="@hint.Id">@hint.Text</p>
    }
    Select();
}
else
{
    <div class="jfb-select">
        @{ Select(); }
    </div>
}
