@* jfb-view: Page 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.PageViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
<section class="@Model.Classes.Page" data-jfb-page="@Model.Key" hidden="@(!Model.IsCurrent || Model.IsHidden)" @FormBuilderHtml.Flag("data-jfb-hidden", Model.IsHidden)>
    @* A text that holds merge tags is written however it renders, hidden while empty, so the runtime can show it (ADR-0115). *@
    @if (Model.Title is not null || Model.Recalling.Contains("title"))
    {
        <h2 class="jfb-title" @FormBuilderHtml.Text(Model, "title") hidden="@(Model.Title is null)">@Model.Title</h2>
    }
    @if (Model.Description is not null || Model.Recalling.Contains("description"))
    {
        <div class="jfb-intro" @FormBuilderHtml.Text(Model, "description") hidden="@(Model.Description is null)">@Model.Description</div>
    }
    @if (Model.Summary is { } summary)
    {
        @await Html.PartialAsync(Model.Views.Summary, summary)
    }
    @foreach (var group in Model.Groups)
    {
        @await Html.PartialAsync(Model.Views.Group, group)
    }
</section>
