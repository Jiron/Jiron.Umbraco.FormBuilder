@* jfb-view: Field 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var labelClass = Model.HideLabel ? Model.Classes.Label + " jfb-visually-hidden" : Model.Classes.Label;
    var mark = FormBuilderHtml.Mark(Model);
    void Help()
    {
        @* A help text that holds merge tags is written however it renders, hidden while empty (ADR-0115). *@
        if (Model.Help is not null || Model.Recalling.Contains("help"))
        {
            <p class="@Model.Classes.Help" id="@Model.HelpId" @FormBuilderHtml.Text(Model, "help") hidden="@(Model.Help is null)">@Model.Help</p>
        }
    }
    void Error()
    {
        if (Model.Error is not null)
        {
            <p class="@Model.Classes.Error" id="@Model.ErrorId" data-jfb-error>@Model.Error</p>
        }
    }
}
<div class="@Model.CssClass" data-jfb-field="@Model.Key" @FormBuilderHtml.Attribute("data-jfb-alias", Model.Alias) data-jfb-type="@Model.Type" hidden="@Model.IsHidden" @FormBuilderHtml.Flag("data-jfb-hidden", Model.IsHidden) @FormBuilderHtml.Flag("data-jfb-default", Model.FillsDefault)>
    @switch (Model.LabelElement)
    {
        case FieldLabelElement.Legend:
            @* A group: the fieldset carries the description; its role takes no invalid state, which a group of choices'
               choices carry with the error, and the parts of a name or an address as the error marks them (6.8c). *@
            <fieldset aria-describedby="@Model.DescribedBy">
                <legend class="@labelClass">@FormBuilderHtml.Label(Model)@mark</legend>
                @{ Help(); }
                @await Html.PartialAsync(Model.ControlView, Model)
                @{ Error(); }
            </fieldset>
            break;
        case FieldLabelElement.Choice:
            @* One box with its own label: the help follows the choice. *@
            @await Html.PartialAsync(Model.ControlView, Model)
            Help();
            Error();
            break;
        default:
            if (Model.LabelElement == FieldLabelElement.Label)
            {
                <label class="@labelClass" for="@Model.Id">@FormBuilderHtml.Label(Model)@mark</label>
            }
            Help();
            @await Html.PartialAsync(Model.ControlView, Model)
            Error();
            break;
    }
</div>
