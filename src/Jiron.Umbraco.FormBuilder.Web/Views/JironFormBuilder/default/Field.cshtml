@* jfb-view: Field 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var labelClass = Model.HideLabel ? Model.Classes.Label + " jfb-visually-hidden" : Model.Classes.Label;
    var mark = FormBuilderHtml.Mark(Model);
    void Help()
    {
        if (Model.Help is not null)
        {
            <p class="@Model.Classes.Help" id="@Model.HelpId">@Model.Help</p>
        }
    }
    void Error()
    {
        if (Model.Error is not null)
        {
            <p class="@Model.Classes.Error" id="@Model.ErrorId" data-jfb-error>@Model.Error</p>
        }
    }
}
<div class="@Model.CssClass" data-jfb-field="@Model.Key" @FormBuilderHtml.Attribute("data-jfb-alias", Model.Alias) data-jfb-type="@Model.Type" hidden="@Model.IsHidden" @FormBuilderHtml.Flag("data-jfb-hidden", Model.IsHidden)>
    @switch (Model.LabelElement)
    {
        case FieldLabelElement.Legend:
            @* A group of choices: the fieldset carries the description and the error state. *@
            <fieldset aria-describedby="@Model.DescribedBy" aria-invalid="@(Model.Error is null ? null : "true")">
                <legend class="@labelClass">@Model.Label@mark</legend>
                @{ Help(); }
                @await Html.PartialAsync(Model.ControlView, Model)
                @{ Error(); }
            </fieldset>
            break;
        case FieldLabelElement.Choice:
            @* One box with its own label: the help follows the choice. *@
            @await Html.PartialAsync(Model.ControlView, Model)
            Help();
            Error();
            break;
        default:
            if (Model.LabelElement == FieldLabelElement.Label)
            {
                <label class="@labelClass" for="@Model.Id">@Model.Label@mark</label>
            }
            Help();
            @await Html.PartialAsync(Model.ControlView, Model)
            Error();
            break;
    }
</div>
