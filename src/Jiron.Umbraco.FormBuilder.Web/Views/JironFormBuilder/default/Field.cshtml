@* jfb-view: Field 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering.Models
@{
    var labelClass = Model.HideLabel ? "jfb-label jfb-visually-hidden" : "jfb-label";
}
<div class="@Model.CssClass" data-jfb-field="@Model.Key" @FormBuilderHtml.Attribute("data-jfb-alias", Model.Alias) data-jfb-type="@Model.Type" hidden="@Model.IsHidden" @FormBuilderHtml.Flag("data-jfb-hidden", Model.IsHidden)>
    @if (Model.LabelElement == FieldLabelElement.Label)
    {
        switch (Model.Mark)
        {
            case FieldMark.Optional:
                <label class="@labelClass" for="@Model.Id">@Model.Label <span class="jfb-mark">@Model.MarkText</span></label>
                break;
            case FieldMark.Required:
                <label class="@labelClass" for="@Model.Id">@Model.Label <span class="jfb-mark" aria-hidden="true">@Model.MarkText</span></label>
                break;
            default:
                <label class="@labelClass" for="@Model.Id">@Model.Label</label>
                break;
        }
    }
    @if (Model.Help is not null)
    {
        <p class="jfb-help" id="@Model.HelpId">@Model.Help</p>
    }
    @await Html.PartialAsync(Model.ControlView, Model)
    @if (Model.Error is not null)
    {
        <p class="jfb-error" id="@Model.ErrorId" data-jfb-error>@Model.Error</p>
    }
</div>
