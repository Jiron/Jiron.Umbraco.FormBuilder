@* jfb-view: Outcome 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.OutcomeViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
<div class="jfb-outcome" data-jfb-outcome @FormBuilderHtml.Flag("data-jfb-pending", Model.IsPending) tabindex="-1">
    @Model.Message
    @if (Model.Reference is not null)
    {
        <p class="jfb-reference">@Model.Reference</p>
    }
</div>
