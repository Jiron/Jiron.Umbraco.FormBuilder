@* jfb-view: Outcome 1 *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.OutcomeViewModel
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@* A message with a redirect gives its link here: after a post it waits for the visitor; in the form's templates it has the countdown, which the runtime runs after a send, and "Stay here" (ADR-0120). *@
<div class="@Model.Classes.Outcome" data-jfb-outcome @FormBuilderHtml.Flag("data-jfb-pending", Model.IsPending) tabindex="-1">
    @Model.Message
    @if (Model.Reference is not null)
    {
        <p class="jfb-reference" data-jfb-reference>@Model.Reference</p>
    }
    @if (Model.Countdown is { } countdown)
    {
        <p data-jfb-countdown data-jfb-one="@countdown.One" data-jfb-other="@countdown.Other"></p>
    }
    @if (Model.Continue is { } next)
    {
        <div class="@Model.Classes.Navigation">
            <a class="@Model.Classes.Button" href="@next.Url" data-jfb-continue>@next.Text</a>
            @if (Model.Countdown is { } stay)
            {
                <button type="button" class="@Model.Classes.ButtonLink" data-jfb-stay>@stay.Stay</button>
            }
        </div>
    }
</div>
@* The copy of the answers (ADR-0123): the answers once, as the summary page writes them without Change, or a line in their place on a later view; the runtime reveals the print button. *@
@if (Model.Copy is { } copy)
{
    if (copy.Answers is { } answers)
    {
        @await Html.PartialAsync(Model.Views.Summary, answers)
    }
    else
    {
        <p class="@Model.Classes.Help" data-jfb-copy-shown>@copy.ShownText</p>
    }
    <div class="@Model.Classes.Navigation" data-jfb-copy>
        @if (copy.Answers is not null)
        {
            <button type="button" class="@Model.Classes.Button" data-jfb-print hidden><span class="jfb-icon jfb-icon-print" aria-hidden="true"></span>@copy.PrintText</button>
        }
        <a class="@Model.Classes.ButtonLink" href="@copy.Again.Url">@copy.Again.Text</a>
    </div>
}
