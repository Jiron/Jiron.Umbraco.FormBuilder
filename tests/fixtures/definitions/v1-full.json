{
  "schemaVersion": 1,
  "key": "f0000000-0000-4000-8000-000000000001",
  "settings": {
    "submission": {
      "submitLabel": { "": "Send registration", "de": "Anmeldung senden", "de-CH": "Anmeldung abschicken" },
      "nextLabel": { "": "Next" },
      "backLabel": { "": "Back" },
      "summaryPage": true,
      "progress": "bar",
      "store": "days",
