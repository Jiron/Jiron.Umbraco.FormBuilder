              "sensitive": false,
              "includeInEmails": true,
              "keep": "always",
              "autocomplete": "name",
              "cssClass": "badge-name",
              "validation": [ { "kind": "pattern", "pattern": "[A-Za-z ]+", "message": { "": "Letters only." } } ],
              "rules": [
                {
                  "key": "40000000-0000-4000-8000-000000000002",
                  "effect": "require",
                  "enabled": true,
                  "match": "all",
                  "conditions": [ { "field": "30000000-0000-4000-8000-000000000002", "op": "isNotEmpty" } ]
                }
              ],
              "settings": { "counter": true, "maxLength": 80 }
