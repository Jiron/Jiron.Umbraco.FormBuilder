      "description": { "": "<p>We need a few details.</p>" },
      "groups": [
        {
          "key": "20000000-0000-4000-8000-000000000001",
          "title": { "": "Contact" },
          "description": { "": "<p>How we reach you.</p>" },
          "columns": 2,
          "style": "card",
          "rules": [
            {
              "key": "40000000-0000-4000-8000-000000000001",
              "effect": "hide",
              "enabled": false,
              "match": "any",
              "conditions": [ { "context": "memberSignedIn", "op": "isChecked" } ]
