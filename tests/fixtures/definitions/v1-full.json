              "autocomplete": "email",
              "validation": [ { "kind": "uniquePerForm", "message": { "": "You are already registered." } } ],
              "settings": { "confirm": true, "confirmLabel": { "": "Email again" }, "domains": { "list": [ "example.com" ], "mode": "block" } }
            },
            {
              "key": "30000000-0000-4000-8000-000000000003",
              "type": "email",
              "alias": "confirmEmail",
              "span": 1,
              "label": { "": "Email again" },
              "hideLabel": false,
              "required": false,
              "sensitive": false,
              "includeInEmails": true,
              "keep": "always",
              "validation": [ { "kind": "matchesField", "field": "30000000-0000-4000-8000-000000000002", "message": { "": "The addresses differ." } } ]
            }
          ]
        },
        {
          "key": "20000000-0000-4000-8000-000000000002",
