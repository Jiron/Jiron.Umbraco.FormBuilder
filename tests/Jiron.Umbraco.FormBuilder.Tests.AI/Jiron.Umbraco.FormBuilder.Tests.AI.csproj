<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The AI add-on's tests (ADR-0018): unit tests of its readers and prompts, and integration tests on a real Umbraco with
    Umbraco.AI and the fake provider (D22). Apart from Tests.Integration, whose hosts never load Umbraco.AI; the
    management API harness is linked from there, unchanged. Each test gets its own Umbraco.AI SQLite file.
  -->
  <PropertyGroup>
    <JfbUmbracoHost>true</JfbUmbracoHost>
    <JfbUmbracoAI>true</JfbUmbracoAI>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Tests.Integration" />
    <!-- The latest 17.x the add-on was tested with (ADR-0018); the add-on itself compiles against its floor. -->
    <PackageReference Include="Umbraco.AI" VersionOverride="18.7.0" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jiron.Umbraco.FormBuilder\Jiron.Umbraco.FormBuilder.csproj" />
    <ProjectReference Include="..\..\src\Jiron.Umbraco.FormBuilder.AI\Jiron.Umbraco.FormBuilder.AI.csproj" />
    <ProjectReference Include="..\Jiron.Umbraco.FormBuilder.Testing\Jiron.Umbraco.FormBuilder.Testing.csproj" />
    <ProjectReference Include="..\Jiron.Umbraco.FormBuilder.Testing.AI\Jiron.Umbraco.FormBuilder.Testing.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The management API harness of Tests.Integration, linked as it is. -->
    <Compile Include="..\Jiron.Umbraco.FormBuilder.Tests.Integration\Support\FormBuilderTestServerTestBase.cs" Link="Harness\FormBuilderTestServerTestBase.cs" />
    <Compile Include="..\Jiron.Umbraco.FormBuilder.Tests.Integration\Support\BackOfficeApiUsers.cs" Link="Harness\BackOfficeApiUsers.cs" />
    <Compile Include="..\Jiron.Umbraco.FormBuilder.Tests.Integration\ManagementApi\ManagementApiTestBase.cs" Link="Harness\ManagementApiTestBase.cs" />
    <Compile Include="..\Jiron.Umbraco.FormBuilder.Tests.Integration\Access\AccessPersonas.cs" Link="Harness\AccessPersonas.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests.Integration's test settings, linked as they are, so the two hosts start alike. -->
    <None Include="..\Jiron.Umbraco.FormBuilder.Tests.Integration\appsettings.Tests.json" Link="appsettings.Tests.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- As in Tests.Integration: WebApplicationFactory insists on the deps file of Umbraco's own test assembly. -->
  <Target Name="JfbTestServerDepsFile" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDepsFilePath)" DestinationFiles="$(OutDir)Umbraco.Tests.Integration.deps.json" SkipUnchangedFiles="true" />
  </Target>

</Project>
