<Project>

  <!-- The test projects (ADR-0011). The repository-wide settings come first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    What every test project (Tests.Unit, Tests.Integration; not the Testing helper library) needs. The test SDK is
    referenced directly: Umbraco.Cms.Tests.Integration brings it without its build assets, and `dotnet test` then
    silently runs nothing (Tandem's lessons, §3.3).
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('.Tests.'))">
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Tests.'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit3TestAdapter" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!--
    Tests read files of the repository in place (the vector files, the projects the architecture tests check) through
    this attribute, set at build time, so nothing is copied into the output (ADR-0005). RepositoryRoot.Of reads it.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Tests.'))">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JfbRepositoryRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
