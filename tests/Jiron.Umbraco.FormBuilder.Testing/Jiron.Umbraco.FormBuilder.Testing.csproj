<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test-only code for the test hosts and the demo (ADR-0001, ADR-0011, ADR-0029): the HTTP stub on 5560, the test
    clocks, the user and member factories, the mail pickup reader, the test-only endpoints under /jfb-testing/ and the
    architecture rules more than one test project holds a package to. The captcha fakes and the test transport joined
    with their features; the AI fake lives in Testing.AI, as Umbraco.AI's migrations must stay out of the other test
    hosts (ADR-0018). Never packed (IsPackable is false for
    everything outside src/), and never referenced by a package.
  -->
  <ItemGroup>
    <!-- The stub is a small Kestrel server, and the test-only endpoints are ASP.NET Core middleware. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jiron.Umbraco.FormBuilder.Core\Jiron.Umbraco.FormBuilder.Core.csproj" />
    <ProjectReference Include="..\..\src\Jiron.Umbraco.FormBuilder.Web\Jiron.Umbraco.FormBuilder.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests check the endpoints' gate and the stub's internals. -->
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Tests.Unit" />
    <InternalsVisibleTo Include="Jiron.Umbraco.FormBuilder.Tests.Integration" />
  </ItemGroup>

</Project>
