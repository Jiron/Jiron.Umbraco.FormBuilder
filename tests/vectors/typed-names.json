{
  "format": "jfb-vectors/1",
  "suite": "typed-names",
  "defaults": {},
  "fields": {},
  "cases": [
    {
      "id": "a-name-as-it-is",
      "typedName": {
        "typed": "Ana Lima"
      },
      "expect": {
        "name": "Ana Lima"
      }
    },
    {
      "id": "its-ends-trimmed",
      "typedName": {
        "typed": "  Ana Lima  "
      },
      "expect": {
        "name": "Ana Lima"
      }
    },
    {
      "id": "a-run-of-spaces-one-space",
      "typedName": {
        "typed": "Ana \t\n  Lima"
      },
      "expect": {
        "name": "Ana Lima"
      }
    },
    {
      "id": "a-no-break-space-a-space",
      "typedName": {
        "typed": "Ana\u00a0Lima"
      },
      "expect": {
        "name": "Ana Lima"
      }
    },
    {
      "id": "an-ideographic-space-a-space",
      "typedName": {
        "typed": "Ana\u3000Lima"
      },
      "expect": {
        "name": "Ana Lima"
      }
    },
    {
      "id": "composed",
      "typedName": {
        "typed": "Jose\u0301"
      },
      "expect": {
        "name": "Jos\u00e9"
      }
    },
    {
      "id": "without-control-characters",
      "typedName": {
        "typed": "Ana\u0007 Lima\u007f"
      },
      "expect": {
        "name": "Ana Lima"
      }
    },
    {
      "id": "without-a-direction-mark",
      "typedName": {
        "typed": "\u200eAna Lima"
      },
      "expect": {
        "name": "Ana Lima"
      }
    },
    {
      "id": "a-space-after-a-mark-at-the-start-is-gone",
      "typedName": {
        "typed": "\u200e Ana"
      },
      "expect": {
        "name": "Ana"
      }
    },
    {
      "id": "its-joiners-kept",
      "typedName": {
        "typed": "a\u200db\u200cc"
      },
      "expect": {
        "name": "a\u200db\u200cc"
      }
    },
    {
      "id": "another-script-kept",
      "typedName": {
        "typed": "\u5c71\u7530"
      },
      "expect": {
        "name": "\u5c71\u7530"
      }
    },
    {
      "id": "beyond-the-first-plane-kept",
      "typedName": {
        "typed": "Ana \ud83d\ude00"
      },
      "expect": {
        "name": "Ana \ud83d\ude00"
      }
    },
    {
      "id": "nothing-is-no-name",
      "typedName": {
        "typed": ""
      },
      "expect": {
        "name": null
      }
    },
    {
      "id": "only-spaces-is-no-name",
      "typedName": {
        "typed": " \t "
      },
      "expect": {
        "name": null
      }
    },
    {
      "id": "only-marks-is-no-name",
      "typedName": {
        "typed": "\u200e\u0007"
      },
      "expect": {
        "name": null
      }
    },
    {
