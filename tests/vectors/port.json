{
  "format": "jfb-vectors/1",
  "suite": "port",
  "defaults": {
    "context": {
      "now": "2026-06-15T10:00:00Z",
      "timeZone": "Europe/Zurich",
      "culture": "de-CH",
      "member": {
        "signedIn": false,
        "groups": []
      },
      "query": {},
      "hidden": []
    }
  },
  "fields": {
    "name": "text",
    "amount": "number",
    "arrival": "date",
    "phone": "text"
  },
  "cases": [
    {
      "id": "pattern-anchor-repeats-refused",
      "description": "anchors match no character, so the weight is 0; unrolled, the automaton would have a million instructions",
      "values": {
        "phone": [
          "a"
        ]
      },
      "condition": {
        "field": "phone",
        "op": "matches",
        "value": "((^){1000}){1000}"
      },
      "expect": {
        "error": "unsafe_pattern"
      }
    },
    {
      "id": "pattern-empty-group-repeats-refused",
      "description": "an empty group matches no character; its optional copies are a million splits",
      "values": {
        "phone": [
          "a"
        ]
      },
      "condition": {
        "field": "phone",
        "op": "matches",
        "value": "((){0,1000}){1000}"
      },
      "expect": {
        "error": "unsafe_pattern"
      }
    },
    {
      "id": "pattern-deeply-nested-counts-refused",
      "description": "a weight of 10^12 characters; counted in 32-bit integers it wraps around below the limit",
      "values": {
        "phone": [
          "a"
        ]
      },
      "condition": {
        "field": "phone",
        "op": "matches",
        "value": "((((a{1000}){1000}){1000}){1000})"
      },
      "expect": {
        "error": "unsafe_pattern"
      }
    },
    {
      "id": "pattern-instructions-at-the-limit-allowed",
      "description": "ten instructions a copy, a thousand copies: exactly 10,000",
      "values": {
        "phone": [
          "a"
        ]
      },
      "condition": {
        "field": "phone",
        "op": "matches",
        "value": "(^^^^^^^^^a){1000}"
      },
      "expect": false
    },
    {
      "id": "pattern-instructions-over-the-limit-refused",
      "description": "eleven instructions a copy: 11,000",
      "values": {
        "phone": [
          "a"
        ]
      },
      "condition": {
        "field": "phone",
        "op": "matches",
        "value": "(^^^^^^^^^^a){1000}"
      },
      "expect": {
        "error": "unsafe_pattern"
      }
    },
    {
      "id": "pattern-weight-at-the-limit-allowed",
      "values": {
        "phone": [
          ""
        ]
      },
      "condition": {
        "field": "phone",
        "op": "matches",
        "value": "a{1000}b{1000}"
      },
      "expect": true
    },
    {
      "id": "pattern-weight-over-the-limit-refused",
      "values": {
        "phone": [
          "a"
        ]
      },
      "condition": {
        "field": "phone",
        "op": "matches",
        "value": "a{1000}b{1000}c"
      },
      "expect": {
        "error": "unsafe_pattern"
      }
    },
    {
      "id": "field-named-constructor-has-answers",
      "fields": {
        "constructor": "text"
      },
      "values": {
        "constructor": [
          "x"
        ]
      },
      "condition": {
        "field": "constructor",
        "op": "isNotEmpty"
      },
      "expect": true
    },
    {
      "id": "field-named-has-own-property-without-answers",
      "fields": {
        "hasOwnProperty": "text"
      },
      "condition": {
        "field": "hasOwnProperty",
        "op": "isEmpty"
      },
      "expect": true
    },
    {
      "id": "field-to-string-unknown",
      "condition": {
        "field": "toString",
        "op": "isEmpty"
      },
      "expect": {
        "error": "unknown_field"
      }
    },
    {
      "id": "operand-field-value-of-unknown",
      "condition": {
        "field": "arrival",
        "op": "equals",
        "value": {
          "field": "valueOf"
        }
      },
      "expect": {
        "error": "unknown_field"
      }
    },
    {
      "id": "operator-constructor-unknown",
      "values": {
        "name": [
          "Anna"
        ]
      },
      "condition": {
        "field": "name",
        "op": "constructor",
        "value": "x"
      },
      "expect": {
        "error": "unknown_operator"
      }
    },
    {
      "id": "context-query-constructor-is-empty",
      "condition": {
        "context": "query.constructor",
        "op": "isEmpty"
      },
      "expect": true
    },
    {
      "id": "calc-operator-constructor-unknown",
      "calc": {
        "op": "constructor",
        "args": [
          "1",
          "2"
        ]
      },
      "expect": {
        "error": "unknown_operator"
      }
    },
    {
      "id": "calc-operator-to-string-unknown",
      "calc": {
        "op": "toString",
        "args": [
          "1"
        ]
      },
      "expect": {
        "error": "unknown_operator"
      }
    },
    {
      "id": "operand-null-refused",
      "values": {
        "name": [
          "Anna"
        ]
      },
      "condition": {
        "field": "name",
        "op": "equals",
        "value": null
      },
      "expect": {
        "error": "invalid_operand"
      }
    },
    {
      "id": "operand-null-list-refused",
      "condition": {
        "field": "name",
        "op": "isOneOf",
        "value": null
      },
      "expect": {
        "error": "invalid_operand"
      }
    },
    {
      "id": "operand-null-pair-refused",
      "condition": {
        "field": "amount",
        "op": "between",
        "value": null
      },
      "expect": {
        "error": "invalid_operand"
      }
    },
    {
      "id": "operand-null-in-a-list-refused",
      "condition": {
        "field": "name",
        "op": "isOneOf",
        "value": [
          "a",
          null
        ]
      },
      "expect": {
        "error": "invalid_operand"
      }
    },
    {
      "id": "operand-null-where-none-is-taken-refused",
      "condition": {
        "field": "name",
        "op": "isEmpty",
        "value": null
      },
      "expect": {
        "error": "invalid_operand"
      }
    },
    {
      "id": "condition-null-context-reads-as-none",
      "condition": {
        "field": "name",
        "context": null,
        "op": "isEmpty"
      },
      "expect": true
    },
    {
      "id": "now-without-zone-refused",
      "description": "without Z or an offset, each runtime would read its own local time",
      "context": {
        "now": "2026-06-15T10:00:00"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-date-only-refused",
      "context": {
        "now": "2026-06-15"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-without-seconds-refused",
      "context": {
        "now": "2026-06-15T10:00Z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-lower-case-z-refused",
      "context": {
        "now": "2026-06-15T10:00:00z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-offset-without-colon-refused",
      "context": {
        "now": "2026-06-15T10:00:00+0200"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-with-negative-offset",
      "description": "23:30 at UTC-2 is 01:30Z on 16 June, 03:30 in Zurich",
      "context": {
        "now": "2026-06-15T23:30:00-02:00"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-16"
      },
      "expect": true
    },
    {
      "id": "now-with-positive-offset",
      "description": "01:30 at UTC+5 is 20:30Z on 15 June, 22:30 in Zurich",
      "context": {
        "now": "2026-06-16T01:30:00+05:00"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": true
    },
    {
      "id": "now-fraction-never-changes-the-date",
      "description": "the server writes seven places; the last tick before midnight in Zurich (UTC+2)",
      "context": {
        "now": "2026-06-15T21:59:59.9999999Z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": true
    },
    {
      "id": "now-fraction-at-midnight",
      "description": "the browser writes three places",
      "context": {
        "now": "2026-06-15T22:00:00.000Z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-16"
      },
      "expect": true
    },
    {
      "id": "now-ten-fraction-digits-refused",
      "context": {
        "now": "2026-06-15T10:00:00.0000000000Z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-empty-fraction-refused",
      "context": {
        "now": "2026-06-15T10:00:00.Z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-leap-second-refused",
      "context": {
        "now": "2016-12-31T23:59:60Z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2017-01-01"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-invalid-date-refused",
      "context": {
        "now": "2026-02-30T10:00:00Z"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-03-02"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-first-instant",
      "description": "time zone data agrees between platforms from 1970",
      "context": {
        "now": "1970-01-01T00:00:00Z",
        "timeZone": "UTC"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "1970-01-01"
      },
      "expect": true
    },
    {
      "id": "now-before-1970-refused",
      "context": {
        "now": "1969-12-31T23:59:59Z",
        "timeZone": "UTC"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "1969-12-31"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-last-instant",
      "description": "the last second of 9998 in UTC is already 9999 in Auckland",
      "context": {
        "now": "9998-12-31T23:59:59Z",
        "timeZone": "Pacific/Auckland"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "9999-01-01"
      },
      "expect": true
    },
    {
      "id": "now-after-9998-refused",
      "description": "in Auckland, 9999-12-31T23:00Z would be in year 10000",
      "context": {
        "now": "9999-01-01T00:00:00Z",
        "timeZone": "UTC"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "9999-01-01"
      },
      "expect": {
        "error": "invalid_context"
      }
    },
    {
      "id": "now-only-read-when-today-is",
      "description": "a condition that does not look at today never reads the instant",
      "context": {
        "now": "not an instant"
      },
      "values": {
        "name": [
          "Anna"
        ]
      },
      "condition": {
        "field": "name",
        "op": "equals",
        "value": "anna"
      },
      "expect": true
    },
    {
      "id": "time-zone-windows-name-refused",
      "description": "the server on Windows would take it, the browser does not",
      "context": {
        "timeZone": "W. Europe Standard Time"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "unknown_time_zone"
      }
    },
    {
      "id": "time-zone-offset-refused",
      "description": "the browser would take it, the server does not",
      "context": {
        "timeZone": "+01:00"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "unknown_time_zone"
      }
    },
    {
      "id": "time-zone-empty-refused",
      "context": {
        "timeZone": ""
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-15"
      },
      "expect": {
        "error": "unknown_time_zone"
      }
    },
    {
      "id": "time-zone-etc-name",
      "description": "Etc/GMT-14 is UTC+14: 10:00Z is midnight on the next day",
      "context": {
        "now": "2026-06-15T10:00:00Z",
        "timeZone": "Etc/GMT-14"
      },
      "condition": {
        "context": "today",
        "op": "equals",
        "value": "2026-06-16"
      },
      "expect": true
    },
    {
      "id": "time-zone-checked-before-the-relative-date",
      "description": "a relative date reads today too",
      "context": {
        "timeZone": "Mars/Olympus_Mons"
      },
      "values": {
        "arrival": [
          "2026-06-16"
        ]
      },
      "condition": {
        "field": "arrival",
        "op": "equals",
        "value": {
          "today": "+1d"
        }
      },
      "expect": {
        "error": "unknown_time_zone"
      }
    },
    {
      "id": "number-ten-thousand-trailing-zeros",
      "description": "stored as 1; the spike divided by ten once for every zero",
      "number": "1.",
      "expect": "1"
    },
    {
      "id": "number-equals-with-ten-thousand-trailing-zeros",
      "values": {
        "amount": [
          "1"
        ]
      },
      "condition": {
        "field": "amount",
        "op": "equals",
        "value": "1."
      },
      "expect": true
    },
    {
      "id": "number-trailing-zeros-after-a-digit",
      "number": "2.50000",
      "expect": "2.5"
    },
    {
      "id": "number-negative-zero-with-places",
      "number": "-0.000",
      "expect": "0"
    }
  ]
}
