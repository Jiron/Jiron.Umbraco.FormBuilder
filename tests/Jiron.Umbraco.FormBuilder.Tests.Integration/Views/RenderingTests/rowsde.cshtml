@* A repeatable group without labels on a German page (Rendering/FormRenderingRowsTests.cs): the first render, or ?state=posted, a post with one row. *@
@using Jiron.Umbraco.FormBuilder.Tests.Integration.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@inject Jiron.Umbraco.FormBuilder.Web.PublicApi.FormRequests Requests
@{
    Layout = "~/Views/RenderingTests/_Layout.cshtml";
    var key = (await Requests.KeyOfAsync("renderingRowsDe", Context.RequestAborted))!.Value;
    if (FormRenderingRowsTests.GermanState(Context.Request.Query["state"].ToString()) is { } state)
    {
        FormPosts.Set(Context, key, "jfb-1", state);
    }
}
<jfb-render form="renderingRowsDe" />
