@* One form named in each way a page can name it, and values that name no form. *@
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@inject Jiron.Umbraco.FormBuilder.Web.PublicApi.FormRequests Requests
@{
    Layout = "~/Views/RenderingTests/_Layout.cshtml";
    var key = (await Requests.KeyOfAsync("renderingContact", Context.RequestAborted))!.Value;
}
@await Component.InvokeAsync("FormBuilderForm", new { form = key })
@await Component.InvokeAsync("FormBuilderForm", new { form = new FormBuilderFormReference(key) })
<jfb-render form="@key.ToString("D")" />
<jfb-render form="  renderingContact  " />
@await Component.InvokeAsync("FormBuilderForm", new { form = 42 })
@await Component.InvokeAsync("FormBuilderForm", new { form = (object?)null })
<jfb-render form="   " />
<p id="after">The page goes on.</p>
