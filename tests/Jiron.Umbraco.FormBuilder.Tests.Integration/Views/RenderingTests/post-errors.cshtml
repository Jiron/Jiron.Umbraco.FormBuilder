@* A form rendered again after a post without JavaScript that failed: the state the surface action leaves (6.2e). *@
@using Jiron.Umbraco.FormBuilder.Core.FieldTypes
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@inject Jiron.Umbraco.FormBuilder.Web.PublicApi.FormRequests Requests
@{
    Layout = "~/Views/RenderingTests/_Layout.cshtml";
    var key = (await Requests.KeyOfAsync("renderingPosted", Context.RequestAborted))!.Value;
    FormPosts.Set(Context, key, "jfb-1", new FormPostState
    {
        Page = Guid.Parse("30000000-0000-4000-8000-0000000062b2"),
        Answers = new Dictionary<Guid, FieldAnswers> { [Guid.Parse("30000000-0000-4000-8000-000000000084")] = new FieldAnswers(["Bob <b>"]) },
        Errors = new Dictionary<Guid, string> { [Guid.Parse("30000000-0000-4000-8000-000000000084")] = "Enter your whole name" },
        Notice = new FormPostNotice("The form has changed", "Check your answers, then send them again."),
    });
}
<jfb-render form="renderingPosted" />
