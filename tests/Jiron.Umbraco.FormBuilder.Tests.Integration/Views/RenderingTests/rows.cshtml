@* A repeatable group's rows (Rendering/FormRenderingRowsTests.cs): the first render, or ?state=posted, over, hidden or bare, a post's rows, too many rows, a hidden group or no rows. *@
@using Jiron.Umbraco.FormBuilder.Tests.Integration.Rendering
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@inject Jiron.Umbraco.FormBuilder.Web.PublicApi.FormRequests Requests
@{
    Layout = "~/Views/RenderingTests/_Layout.cshtml";
    var key = (await Requests.KeyOfAsync("renderingRows", Context.RequestAborted))!.Value;
    if (FormRenderingRowsTests.State(Context.Request.Query["state"].ToString()) is { } state)
    {
        FormPosts.Set(Context, key, "jfb-1", state);
    }
}
<jfb-render form="renderingRows" />
