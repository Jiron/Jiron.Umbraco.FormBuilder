@* A form rendered again on its second page after a post without JavaScript, with the answers the surface action leaves (6.2e). *@
@using Jiron.Umbraco.FormBuilder.Core.FieldTypes
@using Jiron.Umbraco.FormBuilder.Web.Rendering
@inject Jiron.Umbraco.FormBuilder.Web.PublicApi.FormRequests Requests
@{
    Layout = "~/Views/RenderingTests/_Layout.cshtml";
    var key = (await Requests.KeyOfAsync("renderingRecall", Context.RequestAborted))!.Value;
    FormPosts.Set(Context, key, "jfb-1", new FormPostState
    {
        Page = Guid.Parse("30000000-0000-4000-8000-000000006202"),
        Answers = new Dictionary<Guid, FieldAnswers>
        {
            [Guid.Parse("30000000-0000-4000-8000-000000006210")] = new FieldAnswers(["Ada <Lovelace>"]),
            [Guid.Parse("30000000-0000-4000-8000-000000006211")] = new FieldAnswers(["1234"]),
            [Guid.Parse("30000000-0000-4000-8000-000000006212")] = new FieldAnswers(["x"]),
            [Guid.Parse("30000000-0000-4000-8000-000000006223")] = new FieldAnswers(["later"]),
        },
    });
}
<jfb-render form="renderingRecall" />
