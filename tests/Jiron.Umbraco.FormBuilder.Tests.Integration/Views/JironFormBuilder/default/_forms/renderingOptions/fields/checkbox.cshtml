@* jfb-view: fields/checkbox 1 *@
@* The form renderingOptions' own checkbox, which shows the mark the model gives a view of its own. *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
<input type="checkbox" id="@Model.Id" name="@Model.Name" value="true" data-test-mark="@Model.Mark">
<label for="@Model.Id">@Model.Label</label>
