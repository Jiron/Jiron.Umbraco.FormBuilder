@* jfb-view: Field 1 *@
@* The form renderingOverride's own field wrapper, which the rendering tests look for in place of the built-in one. *@
@model Jiron.Umbraco.FormBuilder.Web.Rendering.Models.FieldViewModel
<div class="jfb-field" data-jfb-field="@Model.Key" data-test-override="field">
    <label for="@Model.Id">@Model.Label</label>
    @await Html.PartialAsync(Model.ControlView, Model)
</div>
