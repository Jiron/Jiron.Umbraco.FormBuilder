<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests on a real Umbraco (ADR-0011): Umbraco.Cms.Tests.Integration 17.x, SQLite here and SQL Server in
    CI. The test SDK, adapter and coverlet come from tests/Directory.Build.props; 3.4 adds the harness in the shape of
    Tandem's lessons (§3.3).
  -->
  <PropertyGroup>
    <!-- It runs a whole Umbraco site, so the host-only audit entries apply (NuGetAudit.props, ADR-0024). -->
    <JfbUmbracoHost>true</JfbUmbracoHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <!-- The meta package, as sites install it. -->
    <ProjectReference Include="..\..\src\Jiron.Umbraco.FormBuilder\Jiron.Umbraco.FormBuilder.csproj" />
    <ProjectReference Include="..\Jiron.Umbraco.FormBuilder.Testing\Jiron.Umbraco.FormBuilder.Testing.csproj" />
  </ItemGroup>

</Project>
