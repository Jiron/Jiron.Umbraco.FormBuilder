{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Umbraco.Cms.Tests": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "Tests": {
    "Database": {
      "DatabaseType": "Sqlite",
      "PrepareThreadCount": 4,
      "SchemaDatabaseCount": 4,
      "EmptyDatabasesCount": 2,
      "SQLServerMasterConnectionString": ""
    }
  },
  "JironFormBuilder": {
    "Actions": {
      "Paused": true
    }
  },
  "JironFormBuilderTesting": {
    "StandInActionTypes": true
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "PackageMigrationsUnattended": false
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      }
    }
  }
}
