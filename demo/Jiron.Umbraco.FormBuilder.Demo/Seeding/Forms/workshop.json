{
  "schemaVersion": 1,
  "key": "d0000000-0000-4000-8000-000000000002",
  "settings": {
    "submission": {
      "submitLabel": { "": "Book my place", "de": "Platz buchen" }
    },
    "availability": {
      "members": "members"
    }
  },
  "pages": [
    {
      "key": "d0000000-0000-4000-8000-000000000020",
      "groups": [
        {
          "key": "d0000000-0000-4000-8000-000000000021",
          "columns": 2,
          "fields": [
            {
              "key": "d0000000-0000-4000-8000-000000000201",
              "type": "radio",
              "alias": "workshop",
              "span": 2,
              "label": { "": "Workshop", "de": "Workshop" },
              "required": true,
              "settings": { "layout": "cards" },
              "options": {
                "items": [
                  {
                    "value": "bikes",
                    "label": { "": "Bike repair basics", "de": "Fahrrad-Reparatur für Einsteiger" },
                    "description": { "": "Saturday, 10:00 to 12:00", "de": "Samstag, 10 bis 12 Uhr" }
                  },
                  {
                    "value": "mending",
                    "label": { "": "Mending clothes", "de": "Kleidung flicken" },
                    "description": { "": "Saturday, 14:00 to 16:00", "de": "Samstag, 14 bis 16 Uhr" }
                  }
                ]
              }
            },
            {
              "key": "d0000000-0000-4000-8000-000000000202",
              "type": "text",
              "alias": "name",
              "label": { "": "Your name", "de": "Ihr Name" },
              "required": true,
              "autocomplete": "name"
            },
            {
              "key": "d0000000-0000-4000-8000-000000000207",
              "type": "yesno",
              "alias": "bringGuests",
              "span": 2,
              "label": {
                "": "Is anyone coming with {{ field.name | default: \"you\" }}?",
                "de": "Kommt jemand mit {{ field.name | default: \"Ihnen\" }}?"
              },
              "required": true
            },
            {
              "key": "d0000000-0000-4000-8000-000000000203",
              "type": "repeater",
              "alias": "guests",
              "span": 2,
              "rules": [
                {
                  "key": "d0000000-0000-4000-8000-000000000270",
                  "effect": "show",
                  "enabled": true,
                  "match": "all",
                  "conditions": [{ "field": "d0000000-0000-4000-8000-000000000207", "op": "equals", "value": "yes" }]
                }
              ],
              "label": { "": "Who comes with you", "de": "Wer mit Ihnen kommt" },
              "help": { "": "Up to three guests per booking.", "de": "Bis zu drei Gäste pro Buchung." },
              "settings": {
                "maxRows": 3,
                "rowLabel": { "": "Guest", "de": "Gast" },
                "addLabel": { "": "Add a guest", "de": "Gast hinzufügen" }
              },
              "fields": [
                {
                  "key": "d0000000-0000-4000-8000-000000000205",
                  "type": "text",
                  "alias": "guestName",
                  "label": { "": "Name", "de": "Name" },
                  "required": true
                },
                {
                  "key": "d0000000-0000-4000-8000-000000000206",
                  "type": "radio",
                  "alias": "guestAge",
                  "label": { "": "Age", "de": "Alter" },
                  "settings": { "layout": "horizontal" },
                  "options": {
                    "items": [
                      { "value": "under16", "label": { "": "Under 16", "de": "Unter 16" } },
                      { "value": "adult", "label": { "": "16 or over", "de": "16 oder älter" } }
                    ]
                  }
                }
              ]
            },
            {
              "key": "d0000000-0000-4000-8000-000000000204",
              "type": "textarea",
              "alias": "notes",
              "span": 2,
              "label": { "": "Anything the leader should know?", "de": "Sollte die Leitung etwas wissen?" },
              "help": {
                "": "For {{ field.workshop | default: \"the workshop\" }}: access needs, allergies or a question.",
                "de": "Für {{ field.workshop | default: \"den Workshop\" }}: Barrierefreiheit, Allergien oder eine Frage."
              },
              "settings": { "rows": 4, "counter": true, "maxLength": 1000 }
            },
            {
              "key": "d0000000-0000-4000-8000-000000000208",
              "type": "paragraph",
              "span": 2,
              "settings": {
                "html": {
                  "": "<p>Guests on this booking: {{ field.guests.guestName | default: \"none\" }}. We hold every place until ten minutes before the start.</p>",
                  "de": "<p>Gäste dieser Buchung: {{ field.guests.guestName | default: \"keine\" }}. Wir halten jeden Platz bis zehn Minuten vor Beginn frei.</p>"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
