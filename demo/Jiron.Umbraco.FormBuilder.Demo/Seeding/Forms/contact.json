{
  "schemaVersion": 1,
  "key": "d0000000-0000-4000-8000-000000000001",
  "settings": {
    "submission": {
      "submitLabel": { "": "Send message", "de": "Nachricht senden" }
    },
    "developer": { "queryValues": [ "source" ], "contextValues": [ "topic" ] }
  },
  "pages": [
    {
      "key": "d0000000-0000-4000-8000-000000000010",
      "groups": [
        {
          "key": "d0000000-0000-4000-8000-000000000011",
          "columns": 2,
          "fields": [
            {
              "key": "d0000000-0000-4000-8000-000000000101",
              "type": "text",
              "alias": "name",
              "label": { "": "Your name", "de": "Ihr Name" },
              "required": true,
              "autocomplete": "name",
              "prefill": { "member": "name" }
            },
            {
              "key": "d0000000-0000-4000-8000-000000000102",
              "type": "email",
              "alias": "email",
              "label": { "": "Email address", "de": "E-Mail-Adresse" },
              "help": { "": "We use it only to answer you.", "de": "Wir nutzen sie nur für unsere Antwort." },
              "required": true,
              "sensitive": true,
              "autocomplete": "email",
              "prefill": { "member": "email", "memberMode": "hide" }
            },
            {
              "key": "d0000000-0000-4000-8000-000000000105",
              "type": "dropdown",
              "alias": "topic",
              "label": { "": "What is it about?", "de": "Worum geht es?" },
              "options": {
                "items": [
                  { "value": "general", "label": { "": "A general question", "de": "Eine allgemeine Frage" } },
                  { "value": "account", "label": { "": "Your account", "de": "Ihr Konto" } },
                  { "value": "booking", "label": { "": "A booking", "de": "Eine Buchung" } },
                  { "value": "collection", "label": { "": "Our collection", "de": "Unser Bestand" } }
                ]
              },
              "prefill": { "context": "topic" }
            },
            {
              "key": "d0000000-0000-4000-8000-000000000106",
              "type": "text",
              "alias": "source",
              "label": { "": "Where did you hear about us?", "de": "Wie haben Sie von uns erfahren?" },
              "prefill": { "query": "source" }
            },
            {
              "key": "d0000000-0000-4000-8000-000000000103",
              "type": "phone",
              "alias": "phone",
              "span": 2,
              "label": { "": "Phone", "de": "Telefon" },
              "help": { "": "If you would rather we call you back.", "de": "Falls Sie lieber einen Rückruf möchten." },
              "sensitive": true,
              "autocomplete": "tel"
            },
            {
              "key": "d0000000-0000-4000-8000-000000000104",
              "type": "textarea",
              "alias": "message",
              "span": 2,
              "label": { "": "Your message", "de": "Ihre Nachricht" },
              "required": true,
              "settings": { "rows": 6, "counter": true, "maxLength": 2000 }
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "d0000000-0000-4000-8000-000000000201",
      "type": "email",
      "name": "Notify the team",
      "settings": {
        "to": [ "team@lindenhall.example" ],
        "replyToField": "d0000000-0000-4000-8000-000000000102",
        "includeSensitive": [ "d0000000-0000-4000-8000-000000000102", "d0000000-0000-4000-8000-000000000103" ],
        "withoutUnanswered": true,
        "subject": { "": "New message from {{ field.name }}", "de": "Neue Nachricht von {{ field.name }}" },
        "body": {
          "": "<p>A new message came in through the contact form.</p>{{ entry.table }}",
          "de": "<p>Über das Kontaktformular ist eine neue Nachricht eingegangen.</p>{{ entry.table }}"
        }
      }
    },
    {
      "key": "d0000000-0000-4000-8000-000000000202",
      "type": "email",
      "name": "Confirm to the sender",
      "settings": {
        "toField": "d0000000-0000-4000-8000-000000000102",
        "subject": { "": "We have your message", "de": "Wir haben Ihre Nachricht erhalten" },
        "body": {
          "": "<p>Hello {{ field.name }},</p><p>thank you for writing to us. We answer within two working days. You wrote:</p><blockquote>{{ field.message }}</blockquote>",
          "de": "<p>Guten Tag {{ field.name }},</p><p>danke für Ihre Nachricht. Wir antworten innerhalb von zwei Werktagen. Sie schrieben:</p><blockquote>{{ field.message }}</blockquote>"
        }
      }
    }
  ]
