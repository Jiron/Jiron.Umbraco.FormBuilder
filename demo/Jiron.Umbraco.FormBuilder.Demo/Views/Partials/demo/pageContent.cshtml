@inherits UmbracoViewPage
@* A page's own content: its heading, introduction, body text, blocks and form (ROADMAP 3.3, 6.2b), which takes the page's
   topic as a context value (ADR-0124). *@
<h1>@(Model.Value<string>("heading") ?? Model.Name)</h1>
@if (Model.HasValue("lede"))
{
    <p class="site-lede">@(Model.Value<string>("lede"))</p>
}
@if (Model.HasValue("bodyText"))
{
    <div class="site-body">@(Model.Value<IHtmlEncodedString>("bodyText"))</div>
}
@await Html.GetBlockListHtmlAsync(Model, "blocks")
@if (Model.Value<string>("form") is { Length: > 0 } form)
{
    <jfb-render form="@form" theme="@Jiron.Umbraco.FormBuilder.Demo.DemoThemes.Of(Context)" context-topic="@(Model.HasValue("formTopic") ? Model.Value<string>("formTopic") : null)" />
}
