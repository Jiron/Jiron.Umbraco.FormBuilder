                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProblemDetails"
                    }
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large: the body is longer than the endpoint takes (payload_too_large).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ProblemDetails"
                    }
                  ]
                }
