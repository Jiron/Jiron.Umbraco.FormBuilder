        "properties": {
          "ready": {
            "type": "boolean"
          },
          "problem": {
            "type": "string",
            "nullable": true
          },
          "profileName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AISuggestedTextResponseModel": {
        "required": [
          "path",
          "setting",
          "text"
        ],
        "type": "object",
        "properties": {
          "setting": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AISuggestionRequestModel": {
        "required": [
          "fieldKey"
