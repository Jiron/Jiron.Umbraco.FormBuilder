  "components": {
    "schemas": {
      "AIDraftRequestModel": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 20000,
            "minLength": 0,
            "type": "string"
          },
          "folderKey": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AIDraftResponseModel": {
        "required": [
          "draftVersion",
          "key",
          "left",
          "name"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "draftVersion": {
            "type": "integer",
            "format": "int32"
          },
          "left": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AIMarkResponseModel": {
        "type": "object",
        "properties": {
          "draftVersion": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
