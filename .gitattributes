# Normalise text to LF in the repository and the working tree.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.gz binary
*.nupkg binary
*.snupkg binary
*.dll binary
*.exe binary
*.db binary
*.sqlite binary
*.eml binary

# Third-party files copied byte for byte (THIRD-PARTY-NOTICES): kept exactly as published, never normalised, and
# checked against the published files' hashes by scripts/tests/demo-vendor.test.mjs.
demo/Jiron.Umbraco.FormBuilder.Demo/wwwroot/demo/vendor/** -text -diff linguist-vendored
